{
  "name": "messaging-app",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --loader ts-node/esm --experimental-specifier-resolution=node src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:app": "node --loader ts-node/esm --experimental-specifier-resolution=node src/app.ts",
    "db:seed": "node prisma/seed.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "better-sqlite3": "^12.8.0",
    "express": "^5.2.1",
    "prisma": "^7.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
